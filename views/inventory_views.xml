<?xml version="1.0" encoding="utf-8"?>

<odoo>
<!--_________________________________ Medicine Inventory _____________________________________-->

    <record id="medicine_inventory_list" model="ir.ui.view">
        <field name="name">Medicine Inventory</field>
        <field name="model">sd_clinic.medicine_inventory</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="quantity"/>
                    <field name="receive_date"/>
                </list>
            </field>
    </record>

    <record id="medicine_inventory_search" model="ir.ui.view">
        <field name="name">Medicine Inventory</field>
        <field name="model">sd_clinic.medicine_inventory</field>
            <field name="arch" type="xml">
                <search >
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="quantity"/>
                    <field name="receive_date"/>
                    <filter name="medicine_name" string="Name" context="{'group_by': 'name'}"/>
                    <filter name="project_name" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="receive_date_group" string="Receive" context="{'group_by': 'receive_date'}"/>
                </search>
            </field>
    </record>

    <record id="medicine_inventory_act_window" model="ir.actions.act_window">
        <field name="name">Medicine</field>
        <field name="res_model">sd_clinic.medicine_inventory</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_project_name': 1}</field>
    </record>
<!--_________________________________ Medicine Prescripts _____________________________________-->

    <record id="medicine_prescripts_list" model="ir.ui.view">
        <field name="name">Medicine Prescripts</field>
        <field name="model">sd_clinic.medicine_prescripts</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="prescript"/>
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="description"/>
                    <field name="on_hand"/>
                    <field name="quantity"/>
<!--                    <field name="receive_date"/>-->
                </list>
            </field>
    </record>

    <record id="medicine_prescripts_search" model="ir.ui.view">
        <field name="name">Medicine Prescripts</field>
        <field name="model">sd_clinic.medicine_prescripts</field>
            <field name="arch" type="xml">
                <search >
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="quantity"/>
<!--                    <field name="receive_date"/>-->
                    <filter name="medicine_name" string="Name" context="{'group_by': 'name'}"/>
                </search>
            </field>
    </record>

    <record id="medicine_prescripts_act_window" model="ir.actions.act_window">
        <field name="name">Medicine Prescripts</field>
        <field name="res_model">sd_clinic.medicine_prescripts</field>
        <field name="view_mode">list</field>
<!--        <field name="context">{'search_default_medicine_name': 1}</field>-->
    </record>
<!--_________________________________ Medicine _____________________________________-->


    <record id="medicine_list" model="ir.ui.view">
        <field name="name">Medicine</field>
        <field name="model">sd_clinic.medicine</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="medicine_type"/>
                    <field name="dose"/>
                    <field name="on_hand"/>
                </list>
            </field>
    </record>

    <record id="medicine_act_window" model="ir.actions.act_window">
        <field name="name">Medicine</field>
        <field name="res_model">sd_clinic.medicine</field>
        <field name="view_mode">list</field>
<!--        <field name="context">{'search_default_medicine_name': 1}</field>-->
    </record>

<!--__________________________________ Medicine Type ____________________________________-->

    <record id="medicine_type_list" model="ir.ui.view">
        <field name="name">Medicine Type</field>
        <field name="model">sd_clinic.medicine_types</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                </list>
            </field>
    </record>


    <record id="medicine_types_act_window" model="ir.actions.act_window">
        <field name="name">Medicine Types</field>
        <field name="res_model">sd_clinic.medicine_types</field>
        <field name="view_mode">list</field>
<!--        <field name="context">{'search_default_medicine_name': 1}</field>-->
    </record>
<!--___________________________________ Menu ___________________________________-->



    <menuitem name="Inventory"
              id="medicine_inventory_menu"
              parent="clinic_configuration_menu"
              action="medicine_inventory_act_window"
              groups="sd_clinic.group_doctors"/>

    <menuitem name="Medicine"
              id="medicine"
              parent="clinic_configuration_menu"
              action="medicine_act_window"
              groups="sd_clinic.group_doctors"/>

    <menuitem name="Medicine Types"
              id="medicine_types_menu"
              parent="clinic_configuration_menu"
              action="medicine_types_act_window"
              groups="sd_clinic.group_doctors"/>

    <menuitem name="Medicine Prescripts"
              id="medicine_prescripts_act_window_menu"
              parent="clinic_configuration_menu"
              action="medicine_prescripts_act_window"
              groups="sd_clinic.group_doctors"/>

</odoo>